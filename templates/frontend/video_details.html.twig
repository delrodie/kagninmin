{% extends 'base.html.twig' %}

{% block title %}{{ video.titre }}{% endblock %}

{% block turbo_frame %}
    <turbo-frame id="main">
        {% block body %}
            <main>
                <section class="page-title cover-background">
                    <div class="container">
                        <div class="row align-items-center small-screen">
                            <div class="col-12 col-md-8">
                                <h4 class="fw-semibold color-gold animate__animated animate__slideInUp ">Galerie</h4>

                                <h1 class="animate__titre  fw-bold color-terra-dark">
                                    Video
                                </h1>
                            </div>
                            <div class="col-md-4 d-none d-md-block">
                                <div class="animate__animated " data-animate="animate__zoomIn" data-parallax="0.3" data-duration="2.0s">
                                    <figure>
                                        <img src="{{ absolute_url(asset('images/autonomisation-circulaire.png')) }}" alt=""
                                             class="img-fluid">
                                    </figure>

                                </div>

                            </div>
                        </div>

                    </div>
                </section>

                <section class="actualites" id="actualites">
                    <div class="container animate__animated">

                        <div class="my-5" style="color: #FDF8F0">.</div>

                        <div class="row mt-5 mb-5">
                            <div class="col-12 col-md-10 col-lg-10 offset-md-1 offset-lg-1">

                                <h4 class="mb-4">{{ video.titre }}</h4>

                                <div class="video-card">

                                    <video id="heroVideo" class="video-player" poster="{{ absolute_url(asset('uploads/videos/cover/' ~ video.cover)) }}" preload="metadata">

                                        <source src="{{ absolute_url(asset('uploads/videos/' ~ video.media)) }}" type="video/mp4">
                                    </video>

                                    <div class="video-overlay" id="videoOverlay">
                                        <button class="play-btn">
                                            <i class="bi bi-play-fill"></i>
                                        </button>
                                    </div>

                                </div>

                            </div>
                        </div>
                        <div class="my-5" style="color: #FDF8F0">.</div>
                        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 mt-5" style="margin-top: 200px;">
                            {% for other in videos|slice(0,4) %}
                                <div class="col">
                                    <div class="card h-100 rounded-0 border-0 shadow">
                                        <a href="{{ absolute_url(path('app_video_show', {'slug': other.slug})) }}" class="text-decoration-none" data-turbo="false">
                                            <figure class="overflow-hidden position-relative mb-0">

                                                <img src="{{ absolute_url(asset('/uploads/videos/cover/' ~ other.cover)) }}" alt="{{ other.titre }}" class="card-img-top">

                                                <figcaption class="video-overlay">
                                                    <i class="bi bi-play-circle-fill play-icon-static"></i>
                                                </figcaption>

                                            </figure>

                                        </a>
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <a href="{{ absolute_url(path('app_video_show', {'slug': other.slug})) }}" class="text-decoration-none color-terra" data-turbo="false">
                                                    {{ other.titre }}
                                                </a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="my-5" style="color: #FDF8F0">.</div>

                    </div>
                </section>



                <div {{ stimulus_controller('partenaire-loader',{ url: path('app_partenaire_list')}) }} style="margin-top: 100px;">
                    <div data-partenaire-loader-target="content">
                        <div class="text-center mt-5 p-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Chargement des partenaires...</span>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        {% endblock %}
    </turbo-frame>
{% endblock %}


{% block head %}
    {# === TITLE & DESCRIPTION === #}
    <title>Galerie - {{ video.titre|default('Galerie') }} - ONG KAGNINMIN</title>
    <meta name="description" content="{{ video.description|striptags|slice(0, 160)|default('Découvrez nos actions') }}">

    {# === Open Graph / Facebook === #}
    <meta property="og:title" content="{{ video.titre|default('Galerie vidéo') }} - ONG KAGNINMIN">
    <meta property="og:description" content="{{ video.description|striptags|slice(0, 160)|default('Découvrez nos actions') }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ absolute_url(path('app_video_show', {'slug': video.slug})) }}">

    {# Image principale (très important) #}
    {% if video.cover %}
        <meta property="og:image" content="{{ absolute_url(asset('uploads/videos/cover/' ~ video.cover)) }}">
    {% else %}
        <meta property="og:image" content="{{ absolute_url(asset('images/autonomisation-circulaire.png')) }}">
    {% endif %}

    <meta property="og:site_name" content="ONG KAGNINMIN">
    <meta property="og:locale" content="fr_FR">

    {# === Twitter Cards === #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ video.titre|default('Actualité') }} - ONG KAGNINMIN">
    <meta name="twitter:description" content="{{ video.description|striptags|slice(0, 160)|default('Galerie video') }}">

    {% if video.cover %}
        <meta name="twitter:image" content="{{ absolute_url(asset('uploads/videos/cover/' ~ video.cover)) }}">
    {% endif %}

    {# Optionnel : Auteur / Date #}
    {% if video.createdAt is defined %}
        <meta property="article:published_time" content="{{ video.createdAt|date('c') }}">
    {% endif %}
{% endblock %}

{% block extra_javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            const video = document.getElementById('heroVideo');
            const overlay = document.getElementById('videoOverlay');

            overlay.addEventListener('click', () => {

                video.setAttribute('controls', true);

                video.play();

                overlay.style.opacity = 0;
                overlay.style.pointerEvents = 'none';
            });

            video.addEventListener('pause', () => {
                overlay.style.opacity = 1;
                overlay.style.pointerEvents = 'all';
            });

        });
    </script>
{% endblock %}
